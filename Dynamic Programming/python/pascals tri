class Solution(object):
    def generate(self, numRows):
        """
        :type numRows: int
        :rtype: List[List[int]]
        """
        if numRows == 0:
            return []

        result = [[1]]
        first = [1]

        for i in range(1, numRows):
            second = [1]

            for i in range(len(first) - 1):
                T = first[i] + first[i + 1]
                second.append(T)

            second.append(1)
            result.append(second)
            first = second

        return result
