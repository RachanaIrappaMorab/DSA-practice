class Solution(object):
    def longestCommonPrefix(self, strs):
        """
        :type strs: List[str]
        :rtype: str
        """
        result=""
        for i in range(len(strs[0])):
            first=strs[0][i]
            for word in strs:
                if i>=len(word) or word[i]!=first:
                    return result
                    exit()
            result+=first
        return result
        
