class Solution(object):
    def longestPalindrome(self, s):
        """
        :type s: str
        :rtype: str
        """
        long=""
        for i in range(len(s)):
            for j in range(i,len(s)):
                substring=s[i:j+1]
                if substring==substring[::-1]:
                    if len(substring)>len(long):
                        long=substring


        return long
